# clawsharp environment variables
# Copy this file to .env and fill in your values.
# .env is git-ignored; .env.example is tracked.
#
# These variables are referenced in config.json via ${VAR} expansion
# and in compose.yaml for Docker services.

# ── Config ────────────────────────────────────────────────────────────────────

# Optional: override the config file location.
# Defaults: $CLAWSHARP_CONFIG → ./config.json → ~/.clawsharp/config.json
#CLAWSHARP_CONFIG=~/.clawsharp/config.json

# ── LLM Provider API Keys ─────────────────────────────────────────────────────

# OpenAI (or any OpenAI-compatible provider: OpenRouter, Groq, Mistral, etc.)
OPENAI_API_KEY=

# Anthropic (Claude models)
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Brave Search (used by the web_search tool; falls back to DuckDuckGo if unset)
BRAVE_API_KEY=

# ── Memory: Database Connection ───────────────────────────────────────────────
# Required when memory.backend is "postgres" or "mssql" in config.json.
# Reference in config.json as: "connectionString": "${CLAWSHARP_DB_CONNECTION}"

# PostgreSQL example:
#CLAWSHARP_DB_CONNECTION=Host=localhost;Port=5432;Database=clawsharp;Username=clawsharp;Password=secret

# MS SQL Server example:
#CLAWSHARP_DB_CONNECTION=Server=localhost,1433;Database=clawsharp;User Id=sa;Password=YourStrong!Password1;TrustServerCertificate=True

CLAWSHARP_DB_CONNECTION=

# ── Docker Compose: PostgreSQL service ────────────────────────────────────────
# Used when running: docker compose --profile postgres up
POSTGRES_PASSWORD=changeme

# ── Docker Compose: MS SQL Server 2025 service ───────────────────────────────
# Used when running: docker compose --profile mssql up
# Must be a strong password: min 8 chars, upper + lower + digit + symbol.
MSSQL_SA_PASSWORD=YourStrong!Password1

# ── Channels ──────────────────────────────────────────────────────────────────
# These can also be set directly in config.json; env vars are an alternative.

# Telegram bot token (from @BotFather)
#TELEGRAM_TOKEN=

# Discord bot token
#DISCORD_TOKEN=

# Slack bot token (xoxb-...) and app-level token (xapp-...)
#SLACK_BOT_TOKEN=
#SLACK_APP_TOKEN=

# Web channel pairing token (shared secret for REST/WS auth)
#WEB_PAIRING_TOKEN=
