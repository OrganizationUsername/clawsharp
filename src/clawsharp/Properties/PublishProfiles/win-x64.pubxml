<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows x64 self-contained publish profile.
  Produces a single-file .exe bundling the .NET runtime — no dotnet install needed on target.

  Usage:
    dotnet publish clawsharp/clawsharp.csproj /p:PublishProfile=win-x64
    - or -
    make publish-windows  (from repo root, on Windows)
-->
<Project>
    <PropertyGroup>
        <Configuration>Release</Configuration>
        <Platform>Any CPU</Platform>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <PublishDir>$(MSBuildThisFileDirectory)..\..\dist\win-x64\</PublishDir>
    </PropertyGroup>
</Project>
