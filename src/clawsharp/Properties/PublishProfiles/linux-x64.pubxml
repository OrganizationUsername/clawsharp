<?xml version="1.0" encoding="utf-8"?>
<!--
  Linux x64 self-contained publish profile.
  Produces a single-file executable bundling the .NET runtime — no dotnet install needed on target.
  Compatible with: Arch Linux, Debian, Ubuntu, Fedora, RHEL, and any glibc x86-64 distro.

  Usage:
    dotnet publish clawsharp/clawsharp.csproj /p:PublishProfile=linux-x64
    - or -
    make publish-linux  (from repo root)
-->
<Project>
    <PropertyGroup>
        <Configuration>Release</Configuration>
        <Platform>Any CPU</Platform>
        <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <PublishDir>$(MSBuildThisFileDirectory)..\..\dist\linux-x64\</PublishDir>
    </PropertyGroup>
</Project>
